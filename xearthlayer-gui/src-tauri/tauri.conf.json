{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XEarthLayer",
  "mainBinaryName": "xearthlayer-gui",
  "identifier": "io.github.samsoir.xearthlayer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XEarthLayer",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "category": "Simulation",
    "shortDescription": "Satellite imagery for X-Plane, streamed on demand",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "../../pkg/macos/xearthlayer.entitlements",
      "minimumSystemVersion": "15.4"
    },
    "linux": {
      "deb": { "depends": ["fuse3"] }
    }
  }
}
